# Copie para .env.local e ajuste.

# URL base da API do backend do Gallifrey (sem barra no final).
VITE_API_URL=/api

# true = usa o backend simulado no navegador (localStorage), útil enquanto o backend não existe.
VITE_API_MOCK=true

# Latência artificial do mock, em ms (para visualizar estados de carregamento).
VITE_API_MOCK_LATENCIA=250

# Em desenvolvimento, repassa /api para este servidor (ex.: http://localhost:8000).
VITE_API_PROXY_TARGET=

# Subcaminho onde o app é servido dentro da Cosmo (ex.: /gallifrey/). Padrão: /
VITE_BASE_PATH=/

# Nome da chave do localStorage onde a Cosmo guarda o token JWT do aluno.
VITE_AUTH_TOKEN_KEY=cosmo_token

# Regra pendente na documentação (seção 6): pausar o cronômetro da questão quando a aba fica oculta?
# O tempo oculto é SEMPRE medido e enviado ao backend em `tempo_oculto_segundos`; isto só afeta o que o aluno vê.
VITE_PAUSAR_CRONOMETRO_ABA_OCULTA=false
